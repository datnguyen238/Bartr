# Backend settings. Copy to .env; never commit credentials.
APP_NAME=Bartr

# Saved marketplace data (default). Never commit the real .env.
BARTR_STORAGE=mongo
MONGODB_URI=
MONGODB_DATABASE=bartr
MONGODB_VECTOR_INDEX=item_embeddings

# Explicit temporary local testing only; data disappears on restart:
# BARTR_STORAGE=memory

# Server-only AI assistance. Set models available in your accounts.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_VALUATION_MODEL=
GEMINI_EXTRACTION_MODEL=
GEMINI_MARKET_TIMEOUT_SECONDS=35

# Titan Text Embeddings V2 request format. Choose an available model and region.
AWS_REGION=
BEDROCK_EMBEDDING_MODEL=
BEDROCK_EMBEDDING_DIMENSIONS=1024
# Use the standard AWS credential chain (e.g. an AWS profile); do not put AWS secrets in frontend configuration.

WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Set true behind HTTPS in deployment.
COOKIE_SECURE=false
