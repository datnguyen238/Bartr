# Local development defaults. Do not put real credentials in this file.
APP_NAME=Bartr
BARTR_STORAGE=json
BARTR_JSON_PATH=.bartr/bartr.local.json
BARTR_JSON_MAX_BYTES=67108864

# For the existing DynamoDB table, set BARTR_STORAGE=dynamodb and configure the
# following in the ignored root .env or process environment. Use the AWS SDK
# credential chain; never put access keys in tracked files.
# AWS_PROFILE=bartr-dev
# AWS_REGION=us-east-1
# DYNAMODB_TABLE=bartr-dev
# DYNAMODB_PARTITION_KEY=PK
# DYNAMODB_SORT_KEY=SK

# Legacy MongoDB Atlas mode uses BARTR_STORAGE=mongo and MONGODB_URI.
MONGODB_DATABASE=bartr

WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
COOKIE_SECURE=false
