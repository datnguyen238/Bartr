      "css": ".ds-button-destructive{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;max-width:100%;padding:10px 20px;border:0;border-radius:var(--radius,.875rem);font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;font-size:.875rem;font-weight:500;line-height:1.25rem;white-space:normal;text-align:center;cursor:pointer;transition:color 150ms,background-color 150ms,border-color 150ms;background:var(--destructive,#b8352c);color:var(--destructive-foreground,#fffefa);border:0;}.ds-button-destructive:hover{background:color-mix(in oklab,var(--destructive,#b8352c) 90%,transparent);}.ds-button-destructive:focus-visible{outline:none;box-shadow:0 0 0 2px var(--background,#f5f3ed),0 0 0 5px color-mix(in oklab,var(--ring,#52634b) 60%,transparent);}.ds-button-destructive:active{filter:brightness(.9);}.ds-button-destructive:disabled{pointer-events:none;opacity:.5;}@media(prefers-reduced-motion:reduce){.ds-button-destructive{transition-duration:.01ms;}}"
    },
    {
      "name": "Text field",
      "kind": "input",
      "refersTo": "input",
      "description": "A visible label, strong field boundary, readable value and associated helper text.",
      "html": "<div class=\"ds-field\"><label for=\"ds-title\">Title</label><input id=\"ds-title\" value=\"Wooden study chair\" aria-describedby=\"ds-title-help\"><p id=\"ds-title-help\">Describe the item in a few words.</p></div>",
      "css": ".ds-field{display:grid;gap:8px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;color:var(--foreground,#20211e)}.ds-field label{font-size:.9375rem;font-weight:550}.ds-field input{width:100%;height:44px;min-height:44px;padding:0 12px;border:1px solid var(--input,#8e9185);border-radius:calc(var(--radius,.875rem) - 2px);background:var(--background,#f5f3ed);color:var(--foreground,#20211e);font:inherit;font-size:1rem;transition:box-shadow 150ms}.ds-field input:hover{border-color:var(--input,#8e9185)}.ds-field input:focus-visible{outline:none;border-color:var(--ring,#52634b);box-shadow:0 0 0 2px color-mix(in oklab,var(--ring,#52634b) 25%,transparent)}.ds-field input:disabled{opacity:.5}.ds-field p{margin:0;color:var(--muted-foreground,#65675f);font-size:.875rem;line-height:1.5}@media(prefers-reduced-motion:reduce){.ds-field input{transition-duration:.01ms}}"
    },
    {
      "name": "Main navigation",
      "kind": "nav",
      "refersTo": "navigation-active",
      "description": "Home, Profile and Trade use labeled inline SVG links; Profile remains active throughout its subroutes, and compact navigation uses three columns.",
      "html": "<nav class=\"ds-navigation\" aria-label=\"Main navigation\"><a class=\"ds-nav-link\" href=\"#home\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-7H9v7H4a1 1 0 0 1-1-1Z\"/></svg><span>Home</span></a><a class=\"ds-nav-link\" href=\"#profile\" aria-current=\"page\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"8\" r=\"4\"/><path d=\"M4 21v-2a8 8 0 0 1 16 0v2\"/></svg><span>Profile</span></a><a class=\"ds-nav-link\" href=\"#trade\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 8h15m-4-4 4 4-4 4M20 16H5m4-4-4 4 4 4\"/></svg><span>Trade</span></a></nav>",
      "css": ".ds-navigation{display:grid;gap:6px;max-width:216px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;}.ds-nav-link{display:flex;gap:12px;align-items:center;min-height:48px;padding:12px 14px;border-radius:10px;font-size:.9375rem;font-weight:500;line-height:1.5;color:var(--muted-foreground,#65675f);text-decoration:none;transition:background-color 160ms,color 160ms}.ds-nav-link:hover{background:var(--accent,#e7e9e0);color:var(--foreground,#20211e)}.ds-nav-link[aria-current=\"page\"]{background:var(--primary,#20211e);color:var(--primary-foreground,#fffefa)}.ds-nav-link:focus-visible{outline:2px solid var(--ring,#52634b);outline-offset:4px}.ds-nav-link span{min-width:0;overflow-wrap:anywhere}@media(max-width:767px){.ds-navigation{grid-template-columns:repeat(3,minmax(0,1fr));gap:0;max-width:none;padding:8px 12px max(8px,env(safe-area-inset-bottom));border-top:1px solid var(--border,#dedfd7);background:var(--card,#fffefa)}.ds-nav-link{flex-direction:column;gap:4px;min-height:52px;padding:7px 2px;font-size:.6875rem;line-height:1.3}.ds-nav-link[aria-current=\"page\"]{background:var(--secondary,#eaece4);color:var(--foreground,#20211e)}}@media(prefers-reduced-motion:reduce){.ds-nav-link{transition-duration:.01ms}}"
    },
    {
      "name": "Choice chip",
      "kind": "chip",
      "refersTo": "choice-chip",
      "description": "A wrapping entry with a separately named and comfortable remove control.",
      "html": "<div class=\"ds-choice-chip\"><span>Furniture</span><button type=\"button\" aria-label=\"Remove interest Furniture\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 20 20\" fill=\"none\" aria-hidden=\"true\"><path d=\"m6 6 8 8m0-8-8 8\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\"/></svg></button></div>",
      "css": ".ds-choice-chip{display:inline-flex;align-items:center;gap:6px;max-width:100%;min-height:44px;padding:4px 8px 4px 14px;border-radius:10px;background:var(--secondary,#eaece4);color:var(--foreground,#20211e);font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;font-size:.9375rem}.ds-choice-chip span{min-width:0;overflow-wrap:break-word;padding:8px 0 8px 16px}.ds-choice-chip button{display:inline-flex;align-items:center;justify-content:center;width:44px;height:44px;flex-shrink:0;margin-left:4px;padding:0;border:0;border-radius:9999px;background:transparent;color:inherit;cursor:pointer}.ds-choice-chip button:hover{background:var(--accent,#e7e9e0)}.ds-choice-chip button:focus-visible{outline:none;box-shadow:0 0 0 2px var(--background,#f5f3ed),0 0 0 5px color-mix(in oklab,var(--ring,#52634b) 60%,transparent)}.ds-choice-chip button:active{filter:brightness(.9)}"
    },
    {
      "name": "Surface panel",
      "kind": "card",
      "refersTo": "surface-panel",
      "description": "An opaque bordered panel without elevation shadows.",
      "html": "<section class=\"ds-surface-panel\"><h2>Public details</h2><p>Your display name and community.</p></section>",
      "css": ".ds-surface-panel{padding:28px;border:1px solid var(--border,#dedfd7);border-radius:16px;background:var(--card,#fffefa);color:var(--foreground,#20211e);font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;}.ds-surface-panel h2{margin:0;font-size:1.25rem;font-weight:600;line-height:1.35;letter-spacing:-.015em}.ds-surface-panel p{margin:8px 0 0;color:var(--muted-foreground,#65675f);font-size:.875rem;line-height:1.5}@media(max-width:767px){.ds-surface-panel{padding:22px 20px;border-radius:14px}}@media(max-width:360px){.ds-surface-panel{padding-inline:16px}}"
    },
    {
      "name": "Listing readiness",
      "kind": "custom",
      "refersTo": "listing-readiness",
      "description": "A textual checklist distinguishes completed facts from needed facts before the explicit publish action.",
      "html": "<section class=\"ds-readiness\" aria-label=\"Ready to publish\"><h3>Ready to publish</h3><ul><li>Photo: needed</li><li class=\"ds-readiness-complete\">Title: added</li><li class=\"ds-readiness-complete\">Description: added</li><li class=\"ds-readiness-complete\">Category: added</li><li class=\"ds-readiness-complete\">Condition: added</li></ul><p>Add a photo and complete the item details to publish. You can save a private draft at any time.</p></section>",
      "css": ".ds-readiness{padding-top:20px;border-top:1px solid var(--border,#dedfd7);color:var(--muted-foreground,#65675f);font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;font-size:.875rem}.ds-readiness h3{margin:0;font-size:inherit;font-weight:500}.ds-readiness ul{display:flex;flex-wrap:wrap;gap:8px 16px;list-style:none;margin:12px 0 0;padding:0;line-height:1.5}.ds-readiness .ds-readiness-complete{color:var(--foreground,#20211e)}.ds-readiness p{margin:12px 0 0;line-height:1.5}"
    }
  ],
  "narrative": {
    "northStar": "The Focused Workspace",
    "overview": "Bartr uses a warm cream canvas, opaque paper surfaces, ink actions and a quiet neutral navigation system. The interface gives content, editable facts and the next useful action a clear hierarchy. Border and tonal changes carry structure; compact system typography and comfortable controls keep the workspace familiar.\n\nApple’s principles are translated to the web through clear purpose, familiar controls, responsive composition, local feedback and recoverable actions. This is a record of the implemented web system, with no native HIG certification claim. The visual authority is the current source and reviewed captures; product facts remain in [PRODUCT.md](PRODUCT.md), and the chosen surface composition remains in the [surface brief](.impeccable/surfaces/frontend-app-profile-page-tsx.md).",
    "keyCharacteristics": [
      "Cream and ink, with a complete system dark appearance.",
      "System sans typography with a fixed rem hierarchy.",
      "Opaque bordered surfaces with restrained rounded corners.",
      "Comfortable controls and visible keyboard focus.",
      "Task-local feedback, explicit review and recoverable editing."
    ],
    "rules": [
      {
        "name": "The Semantic Contrast Rule",
        "body": "Use the semantic foreground, surface and state pairs for their intended roles; keep status and error meaning in words as well as color.",
        "section": "colors"
      },
      {
        "name": "The Fixed Rem Rule",
        "body": "Keep the implemented type hierarchy in rem units, allow wrapping and preserve the user’s text size.",
        "section": "typography"
      },
      {
        "name": "The Opaque Surface Rule",
        "body": "Separate content with opaque surfaces, tonal changes and borders; reserve focus rings for interaction feedback.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use the semantic light and dark pairs, keeping body text and helper text readable on their actual surface.",
      "Do keep controls at least 44px high, let labels wrap and retain visible keyboard focus.",
      "Do keep errors, progress and results beside the action, with field labels and associated help or error text.",
      "Do preserve unsaved item drafts while moving within the mounted workspace and explain explicit replacement or discard actions.",
      "Do keep photo saving, draft saving, readiness and publication visibly distinct; present optional AI output for review."
    ],
    "donts": [
      "Don’t add decorative shadows, translucent panels or gradients to the current bordered surface language.",
      "Don’t place item editing beyond the visible collection on compact screens; open the titled modal with its own scrolling body and restore focus on dismissal.",
      "Don’t imply that unsaved drafts survive a reload or session change, or extend their lifetime through browser storage.",
      "Don’t let assistance overwrite reviewed details or make a saved photo appear to publish a listing."
    ]
  }
}
