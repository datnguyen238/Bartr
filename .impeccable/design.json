      "html": "<button type=\"button\" class=\"ds-button-primary\">Save profile</button>",
      "css": ".ds-button-primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;max-width:100%;padding:10px 20px;border:0;border-radius:var(--radius,.875rem);font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;font-size:.875rem;font-weight:500;line-height:1.25rem;white-space:normal;text-align:center;cursor:pointer;transition:color 150ms,background-color 150ms,border-color 150ms;background:var(--primary,#20211e);color:var(--primary-foreground,#fffefa);border:0;}.ds-button-primary:hover{background:color-mix(in oklab,var(--primary,#20211e) 90%,transparent);}.ds-button-primary:focus-visible{outline:none;box-shadow:0 0 0 2px var(--background,#f5f3ed),0 0 0 5px color-mix(in oklab,var(--ring,#52634b) 60%,transparent);}.ds-button-primary:active{filter:brightness(.9);}.ds-button-primary:disabled{pointer-events:none;opacity:.5;}@media(prefers-reduced-motion:reduce){.ds-button-primary{transition-duration:.01ms;}}"
